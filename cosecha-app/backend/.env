# JWT
JWT_SECRET=tu_clave_secreta_muy_segura_cambiar_en_produccion
JWT_EXPIRES_IN=7d

# Servidor
PORT=3000
NODE_ENV=development

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# ── Google OAuth ──
# Crear en https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# ── Resend (email) ──
# Registrate en https://resend.com y obtén tu API key
# Sin esta variable, los emails se imprimen en consola
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=CosechaApp <noreply@tudominio.com>

# ── Twilio (SMS) ──
# Registrate en https://www.twilio.com y obtén tus credenciales
# Sin estas variables, los SMS se imprimen en consola
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+1234567890
