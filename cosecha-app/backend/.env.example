# Base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cosecha_app
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cosecha_app
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=tu_clave_secreta_muy_segura_cambiar_en_produccion
JWT_EXPIRES_IN=7d

# Servidor
PORT=3000
NODE_ENV=development

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# ── Google OAuth ──────────────────────────────────────────────
# 1. Ve a https://console.cloud.google.com/apis/credentials
# 2. Crea un OAuth 2.0 Client ID tipo "Aplicacion web"
# 3. Authorized JavaScript origins: http://localhost:5173 (dev) + tu dominio prod
# 4. Authorized redirect URIs: NO se requieren (usamos Google Identity Services)
# 5. Pega aqui el Client ID (mismo valor en frontend/.env como VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# ── Resend (email) — opcional, sin esto los emails van a consola ──
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=CosechaApp <noreply@tudominio.com>

# ── Twilio (SMS) — opcional, sin esto los SMS van a consola ──
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+1234567890
