VITE_API_URL=http://localhost:3000/api

# ── Google OAuth ──────────────────────────────────────────────
# Mismo Client ID que en backend/.env (GOOGLE_CLIENT_ID).
# Crear en https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID tipo "Aplicacion web", origin http://localhost:5173)
VITE_GOOGLE_CLIENT_ID=

# ── Apple Sign In ─────────────────────────────────────────────
# Services ID configurado en https://developer.apple.com
# Mismo valor que APPLE_SERVICE_ID en backend/.env
VITE_APPLE_CLIENT_ID=
