# Base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cosecha_app
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cosecha_app
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=tu_clave_secreta_muy_segura_cambiar_en_produccion
JWT_EXPIRES_IN=7d

# Servidor
PORT=3000
NODE_ENV=development

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# ── Google OAuth ──────────────────────────────────────────────
# 1. Ve a https://console.cloud.google.com/apis/credentials
# 2. Crea un OAuth 2.0 Client ID tipo "Aplicacion web"
# 3. Authorized JavaScript origins: http://localhost:5173 (dev) + tu dominio prod
# 4. Authorized redirect URIs: NO se requieren (usamos Google Identity Services)
# 5. Pega aqui el Client ID (mismo valor en frontend/.env como VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# ── Apple Sign In (opcional: login con Apple) ──
# Crear en: https://developer.apple.com/account/resources/identifiers
# Para web se necesita un Services ID (no el App ID)
APPLE_SERVICE_ID=com.tudominio.cosechaapp.web

# ── Resend (email) ─────────────────────────────────────────────
# OBLIGATORIO para que funcione: verificacion de email, recuperar cuenta
# Sin esto, los emails solo se imprimen en consola (desarrollo)
# Pasos:
#   1. Crea cuenta gratis en https://resend.com (100 emails/dia)
#   2. API Keys → Create API Key → copia aqui
#   3. Para produccion: Settings → Domains → verifica tu dominio
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=CosechaApp <onboarding@resend.dev>

# ── Twilio (SMS) ──────────────────────────────────────────────
# OBLIGATORIO para que funcione: login por telefono, recuperar por SMS
# Sin esto, los SMS solo se imprimen en consola (desarrollo)
# Pasos:
#   1. Crea cuenta en https://twilio.com (trial gratis)
#   2. Console → Account Info → copia SID y Token
#   3. Phone Numbers → Buy a Number → copia el numero
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890
